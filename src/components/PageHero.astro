---
import { url } from '../lib/url.js';
const { title, subtitle, crumbs = [], image = 'images/cat-sleep.webp' } = Astro.props;
---
<section class="page-hero" style={`--hero-img:url('${url(image)}')`}>
  <div class="container">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="目前位置">
        <a href={url('')}>首頁</a>
        {crumbs.map((c) => (<><span aria-hidden="true">›</span>{c.href ? <a href={url(c.href)}>{c.label}</a> : <span>{c.label}</span>}</>))}
      </nav>
    )}
    <h1>{title}</h1>
    {subtitle && <p>{subtitle}</p>}
  </div>
</section>
